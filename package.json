{
  "name": "dnd-5r-character-creator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=12288 ./node_modules/vite/bin/vite.js build",
    "build:android": "node --max-old-space-size=12288 ./node_modules/vite/bin/vite.js build --mode android",
    "android:sync": "cap sync android",
    "check:quick-record": "node --test scripts/check-quick-record.mjs",
    "check:offline": "node --test scripts/check-offline.mjs",
    "preview": "vite preview",
    "format:source": "node scripts/format-source.mjs",
    "format:styles": "node scripts/format-styles.mjs",
    "sync:dice-assets": "node scripts/sync-dice-assets.mjs",
    "prepare:android-library": "node scripts/prepare-android-library.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@3d-dice/dice-box": "1.1.4",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
